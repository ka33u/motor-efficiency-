.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a73e8;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
  display: block;
}

.input-field {
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  margin-top: 8rpx;
  background: #fafafa;
}

.input-field:focus {
  border-color: #1a73e8;
}

.query-btn {
  background: #1a73e8;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  margin-top: 8rpx;
  width: 100%;
}

.query-btn::after {
  border: none;
}

.result-section {
  margin-top: 40rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  text-align: center;
  position: relative;
}

.result-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.result-value {
  font-size: 80rpx;
  font-weight: 700;
  color: #1a73e8;
}

.result-unit {
  font-size: 36rpx;
  color: #1a73e8;
  margin-left: 8rpx;
}

.result-badge {
  display: inline-block;
  background: #fff3e0;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin-top: 16rpx;
}

.result-badge.exact {
  background: #e8f5e9;
}

.result-badge .badge-text {
  font-size: 24rpx;
  color: #e65100;
}

.result-badge.exact .badge-text {
  color: #2e7d32;
}

.result-detail {
  margin-top: 32rpx;
  border-top: 1rpx solid #eee;
  padding-top: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.detail-label {
  color: #888;
}

.detail-value {
  color: #333;
  font-weight: 500;
}

.error-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  text-align: center;
  border-left: 8rpx solid #d32f2f;
}

.error-text {
  font-size: 30rpx;
  color: #d32f2f;
}

.footer {
  text-align: center;
  margin-top: 48rpx;
  padding-bottom: 40rpx;
}

.footer-text {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.8;
}
